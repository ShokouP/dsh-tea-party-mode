{
  "name": "dsh-tea-party-mode",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "角色茶话会模式 — 和极简/创造并列的 Agent 预设：8 位大模型娘围桌语c，行首带角色头像；默认零工具，可选接 OpenAI 兼容后端让角色真实调用各家模型（未配置的角色由本模型自演）。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./avatars/*.png": "./avatars/*.png",
    "./avatars/index.json": "./avatars/index.json",
    "./avatars/CREDITS.md": "./avatars/CREDITS.md"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "avatars/*.png",
    "avatars/index.json",
    "avatars/CREDITS.md"
  ],
  "license": "MIT"
}
